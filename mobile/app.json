{
  "expo": {
    "name": "Safadd",
    "slug": "safadd-app",
    "version": "1.1.21",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safadd",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safadd.app",
      "buildNumber": "1.1.21"
    },
    "android": {
      "package": "com.safadd.app",
      "versionCode": 18,
      "allowBackup": true,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#141714",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "dangerousPropertyThatWillBeModifiedByPrebuild": {
        "additionalManifestAttributes": {
          "xmlns:tools": "http://schemas.android.com/tools"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141714",
          "dark": {
            "backgroundColor": "#141714"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#141714",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraAndroidManifestAttributes": {
              "tools:replace": "android:allowBackup"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "605988fa-8668-4210-89d5-c7f997a4d726"
      }
    }
  }
}
